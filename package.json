{
  "name": "nexo",
  "version": "1.0.0",
  "description": "Next-gen Discord-style messenger prototype",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "dev:client": "cd client && npm run dev",
    "start": "electron .",
    "test": "node server.js --check-config",
    "build:client": "npm run build --prefix client",
    "prepare:public": "node scripts/prepare-public.js",
    "build:app": "npm run build:client && npm run prepare:public && node scripts/prepare-node.js",
    "electron:build": "npm run build:app && electron-builder build --win --publish never",
    "electron:dev": "electron .",
    "electron:package": "electron-builder build --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "clamscan": "^2.4.0",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "file-type": "^18.3.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.10",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "xss-clean": "^0.1.4",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  }
}
